# ═══════════════════════════════════════════════════════════════
# PG-Limiter Configuration
# ═══════════════════════════════════════════════════════════════

# Panel Configuration (Required)
PANEL_DOMAIN=your-panel-domain.com:8443
PANEL_USERNAME=admin
PANEL_PASSWORD=your_password
# Verify the panel's TLS certificate. Off by default because most installs use a
# self-signed certificate. Covers both the API calls and the node log streams.
PANEL_VERIFY_SSL=false

# Telegram Bot (Required)
BOT_TOKEN=YOUR_BOT_TOKEN
# Comma-separated admin chat IDs
ADMIN_IDS=

# ═══════════════════════════════════════════════════════════════
# Limiter Settings
# ═══════════════════════════════════════════════════════════════

# Default IP limit per user
GENERAL_LIMIT=2

# Check interval in seconds. 180-300 is the practical range on a busy panel:
# below that the monitoring window (CHECK_INTERVAL x MAX_WARNING_COUNT) gets too
# short for a user to correct themselves, and a cycle that over-runs the interval
# degrades the consecutive-scan timing.
CHECK_INTERVAL=180

# Number of consecutive warning cycles before disabling a user (default: 3)
# MAX_WARNING_COUNT=3

# Default time before re-enabling disabled users (seconds)
# Users can have custom punishment times via Telegram
TIME_TO_ACTIVE_USERS=900

# Country code filter (IR, RU, CN, or empty for all)
COUNTRY_CODE=

# API Last seen: exact positive seconds, independent of CHECK_INTERVAL.
# An IP counts only while 0 <= evaluation time - Xray timestamp < this value.
# Xray timestamps update when tracked connections open; long-lived connections can
# have old timestamps. Telegram Settings -> IP Source -> Last seen overrides ENV.
# See docs/API_IP_SOURCE.md for legacy Auto migration and incomplete evidence.
# API_IP_FRESHNESS=60

# Minimum share of queried users that must answer before an API-mode cycle is allowed
# to enforce, as a percentage. Below it the cycle is skipped instead of acting on a
# partial snapshot, because a thin sample clears the violation counters of real
# offenders. Only used when the IP source is set to the panel API; in log mode it is
# ignored. 0 disables this global gate; unknown users always remain protected.
# API_IP_MIN_COVERAGE=80

# Share of the connected node fleet that must return a valid IP map before an API-mode
# cycle is allowed to enforce, as a percentage. The user-coverage gate above is an answer
# rate per user and reads 100% even when a third of the nodes are silent, which
# under-counts devices. A valid empty map counts as a node response. Off by default (0);
# missing/unavailable nodes still protect affected users regardless of this gate.
# Only used when the IP source is set to the panel API.
# API_IP_MIN_NODE_COVERAGE=0

# ═══════════════════════════════════════════════════════════════
# API Server (Optional)
# ═══════════════════════════════════════════════════════════════
# API_ENABLED=false
# Bind address. 0.0.0.0 is reachable from outside this host and the API has no
# rate limiting, so prefer 127.0.0.1 unless something in front of it is filtering.
# API_HOST=127.0.0.1
# API_PORT=8080
# API_USERNAME=admin
# Required. With no password set, every request is refused (503) rather than
# allowed - an empty password used to authenticate everyone.
# API_PASSWORD=secure_password
# /docs, /redoc and /openapi.json are unauthenticated by design in FastAPI, so
# they are off unless you turn them on.
# API_DOCS=false
# Comma-separated browser origins allowed to call the API cross-origin. Empty
# means none, which does not affect curl, scripts or the CLI.
# API_CORS_ORIGINS=

# ═══════════════════════════════════════════════════════════════
# Advanced Settings
# ═══════════════════════════════════════════════════════════════

# Timezone
TZ=UTC

# Database (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:////var/lib/pg-limiter/data/pg_limiter.db
