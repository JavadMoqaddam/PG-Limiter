# ═══════════════════════════════════════════════════════════════
# PG-Limiter Configuration
# ═══════════════════════════════════════════════════════════════

# Panel Configuration (Required)
PANEL_DOMAIN=your-panel-domain.com:8443
# Create a PasarGuard panel API key; panel username/password login is unsupported.
# Upgrade: add this key to the existing .env, preserving other settings.
# Recreate Docker containers after editing .env; see docs/PANEL_API_KEY.md.
PANEL_API_KEY=your_panel_api_key
# Verify panel TLS for API calls and node log streams. Use SSL_CERT_FILE for a
# trusted CA bundle with private certificates; false is an explicit insecure opt-out.
PANEL_VERIFY_SSL=true

# Telegram Bot (Required)
BOT_TOKEN=YOUR_BOT_TOKEN
# Comma-separated admin chat IDs
ADMIN_IDS=

# ═══════════════════════════════════════════════════════════════
# Limiter Settings
# ═══════════════════════════════════════════════════════════════

# Default IP limit per user
GENERAL_LIMIT=2

# Check interval in seconds. 180-300 is the practical range on a busy panel:
# below that the monitoring window (CHECK_INTERVAL x MAX_WARNING_COUNT) gets too
# short for a user to correct themselves, and a cycle that over-runs the interval
# degrades the consecutive-scan timing.
CHECK_INTERVAL=180

# Number of consecutive warning cycles before disabling a user (default: 3)
# MAX_WARNING_COUNT=3

# Default time before re-enabling disabled users (seconds)
# Users can have custom punishment times via Telegram
TIME_TO_ACTIVE_USERS=900

# Country code filter (IR, RU, CN, or empty for all)
COUNTRY_CODE=

# Shared API and SSE/Logs Last seen: exact positive seconds, independent of CHECK_INTERVAL.
# An observation counts only while 0 <= evaluation time - original source timestamp < this value.
# Connection-opening timestamps do not measure ongoing bytes or an idle open connection.
# SSE heartbeats, receipt time and replayed records never renew observation freshness.
# Telegram Settings -> IP Source -> Last seen (api_ip_freshness) overrides ENV for both sources.
# See docs/API_IP_SOURCE.md and docs/LOG_SOURCE.md for configuration and incomplete evidence.
# API_IP_FRESHNESS=60

# Diagnostic threshold for the share of queried users with usable evidence.
# Below it a warning is logged; valid users continue to be evaluated independently.
# Skipped users retain warning counters and history. 0 disables this diagnostic.
# API_IP_MIN_COVERAGE=80

# Legacy node-coverage setting retained for configuration compatibility.
# Node coverage is diagnostic only; it never blocks usable per-user evidence.
# API_IP_MIN_NODE_COVERAGE=0

# ═══════════════════════════════════════════════════════════════
# API Server (Optional)
# ═══════════════════════════════════════════════════════════════
# API_ENABLED=false
# Bind address. 0.0.0.0 is reachable from outside this host and the API has no
# rate limiting, so prefer 127.0.0.1 unless something in front of it is filtering.
# API_HOST=127.0.0.1
# API_PORT=8080
# API_USERNAME=admin
# Required. With no password set, every request is refused (503) rather than
# allowed - an empty password used to authenticate everyone.
# API_PASSWORD=secure_password
# /docs, /redoc and /openapi.json are unauthenticated by design in FastAPI, so
# they are off unless you turn them on.
# API_DOCS=false
# Comma-separated browser origins allowed to call the API cross-origin. Empty
# means none, which does not affect curl, scripts or the CLI.
# API_CORS_ORIGINS=

# ═══════════════════════════════════════════════════════════════
# Advanced Settings
# ═══════════════════════════════════════════════════════════════

# Daily Report sends the previous complete calendar day's ban totals at 00:00.
# The scheduler reads the current TZ environment (IANA zone, e.g. Europe/Berlin).
# Unset defaults to UTC; an explicitly invalid zone pauses daily reporting.
# In-process environment changes reschedule within 60s. Deployment .env edits
# require process restart/container recreation to update its environment.
# LOG_TIMEZONE and LOG_NODE_TIMEZONES below do not control Daily Report scheduling.
TZ=UTC

# Database (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:////var/lib/pg-limiter/data/pg_limiter.db

# Xray access-log process/container timezone, keyed by panel node ID (JSON).
# Set verified values before enabling Logs enforcement; no timezone is inferred.
# Illustrative IDs only: LOG_NODE_TIMEZONES='{"12":"Europe/Istanbul","34":"America/New_York"}'
# Optional default ONLY when verified for every node without an explicit override:
# LOG_TIMEZONE=UTC
# Per-node full-record replay cache. Overflow pauses enforcement until uncertainty expires.
# LOG_REPLAY_CACHE_SIZE=10000
# See docs/LOG_SOURCE.md for readiness, container timezone and clock limitations.
