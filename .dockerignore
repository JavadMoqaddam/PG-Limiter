# Runtime source allowlist. A local workspace can contain operator secrets,
# backups and trial bundles; none should be sent to the build service.
**
!Dockerfile
!requirements.txt
!alembic.ini
!limiter.py
!api_server.py
!cli_main.py
!run_telegram.py
!start.sh
!cli_wrapper.sh
!LICENSE
!README.md
!utils/
!utils/**
!db/
!db/**
!telegram_bot/
!telegram_bot/**
!cli/
!cli/**
!api/
!api/**
!tools/
!tools/**

# Private/generated state remains excluded even inside source directories.
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/*.zip
**/*.tar
**/*.tar.*
**/*.gz
**/*.bak
**/*.backup
**/*.private*
**/backups/
**/backup/
**/data/
